{
  "name": "@vaadin-component-factory/vcf-autocomplete",
  "version": "3.0.0",
  "type": "module",
  "description": "Web Component with a text input that provides a panel of suggested options.",
  "author": "Vaadin Ltd",
  "license": "https://raw.githubusercontent.com/vaadin/vaadin-incubator-element/master/LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vaadin-component-factory/vcf-autocomplete.git"
  },
  "keywords": [
    "Vaadin",
    "vaadin-component-factory",
    "vcf-autocomplete",
    "web-components",
    "web-component",
    "lit"
  ],
  "scripts": {
    "lint": "eslint src/*.js",
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "dev": "npm-run-all --parallel start watch",
    "start": "web-dev-server --node-resolve --port 3000 /demo",
    "publish": "node util/publish.cjs"
  },
  "files": [
    "src",
    "theme"
  ],
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "src/*.js": [
      "eslint --fix",
      "prettier --write",
      "git add"
    ]
  },
  "dependencies": {
    "@lit-labs/observers": "^2.0.0",
    "@vaadin/a11y-base": "^25.0.0",
    "@vaadin/button": "^25.0.0",
    "@vaadin/component-base": "^25.0.0",
    "@vaadin/icon": "^25.0.0",
    "@vaadin/icons": "^25.0.0",
    "@vaadin/item": "^25.0.0",
    "@vaadin/list-box": "^25.0.0",
    "@vaadin/overlay": "^25.0.0",
    "@vaadin/text-field": "^25.0.0",
    "@vaadin/vaadin-lumo-styles": "^25.0.0",
    "@vaadin/vaadin-themable-mixin": "^25.0.0",
    "date-fns": "^2.29.3",
    "lit": "^3.0.0",
    "mobile-drag-drop": "^2.3.0-rc.2",
    "proj4": "^2.9.0",
    "@web/dev-server": "^0.4.6"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5",
    "serve": "^14.2.5",
    "@rollup/plugin-commonjs": "^17.0.0",
    "@rollup/plugin-node-resolve": "^11.1.0",
    "rollup-plugin-terser": "^7.0.2",
    "@rollup/plugin-replace": "^5.0.2",
    "@rollup/pluginutils": "^5.0.2",
    "@vitejs/plugin-react": "^4.0.0",
    "async": "^3.2.2",
    "babel-eslint": "^10.1.0",
    "colors": "^1.3.3",
    "compression-webpack-plugin": "^3.0.0",
    "copy-webpack-plugin": "^5.0.4",
    "eslint": "^5.16.0",
    "eslint-config-prettier": "^6.0.0",
    "eslint-config-vaadin": "^0.2.7",
    "glob": "^7.2.3",
    "mkdirp": "^1.0.4",    
    "@polymer/polymer": "^3.5.1",
    "@polymer/iron-component-page": "^4.0.1",
    "@polymer/iron-demo-helpers": "^3.0.0-pre.19",
    "prettier": "^1.17.1",
    "prompt": "^1.0.0",
    "replace-in-file": "^4.1.2",
    "rollup-plugin-brotli": "^3.1.0",
    "rollup-plugin-visualizer": "^5.9.0",
    "shelljs": "^0.8.3",
    "strip-css-comments": "^5.0.0",
    "terser-webpack-plugin": "^1.4.1",
    "transform-ast": "^2.4.4",
    "typescript": "^5.0.4",
    "uglify-template-string-loader": "^1.1.1",
    "vite": "^4.3.9",
    "workbox-build": "^7.0.0",
    "workbox-core": "^7.0.0",
    "workbox-precaching": "^7.0.0"
  },
  "bugs": {
    "url": "https://github.com/vaadin-component-factory/vcf-autocomplete/issues"
